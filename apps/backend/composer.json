{
  "name": "shipwise/backend",
  "description": "ShipWise AI Phase 1 modular API",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-pdo": "*",
    "doctrine/dbal": "^4.3",
    "doctrine/orm": "^3.5",
    "doctrine/doctrine-bundle": "^2.18",
    "doctrine/doctrine-migrations-bundle": "^3.7",
    "symfony/framework-bundle": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/mailer": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/redis-messenger": "7.4.*",
    "symfony/rate-limiter": "7.4.*",
    "symfony/lock": "7.4.*",
    "symfony/uid": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfony/monolog-bundle": "^3.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.90"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    },
    "allow-plugins": {
      "symfony/runtime": true
    },
    "policy": {
      "advisories": {
        "ignore-id": {
          "PKSA-wtxr-p26d-nn42": {
            "on-audit": false,
            "reason": "Composer audit metadata currently flags symfony/mime v8.0.15 for CVE-2026-45070, but Symfony's official advisory GHSA-vqc8-7275-q272 confirms it was patched in v8.0.12. Temporary false-positive exception for the audit only; keep security blocking enabled and re-check advisory metadata before 2026-11-04."
          }
        }
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=512M",
    "lint": "php-cs-fixer fix --dry-run --diff --using-cache=no"
  }
}
