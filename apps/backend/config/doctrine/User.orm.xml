<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping">
 <entity name="App\Identity\Domain\User" table="users">
  <id name="id" type="string" length="36"/>
  <field name="email" type="string" length="180" unique="true"/>
  <field name="name" type="string" length="100"/>
  <field name="passwordHash" column="password_hash" type="string" length="255"/>
  <field name="kind" type="string" length="16"/>
  <field name="status" type="string" length="32"/>
  <field name="sessionVersion" column="session_version" type="integer"/>
  <field name="createdAt" column="created_at" type="datetimetz_immutable"/>
 <field name="preferredLocale" column="preferred_locale" type="string" length="2"/>
 </entity>
</doctrine-mapping>
