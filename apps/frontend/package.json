{
  "name": "shipwise-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript ../../docs/api/openapi.json -o src/api/generated.ts",
    "api:validate": "redocly lint ../../docs/api/openapi.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.1",
    "@redocly/cli": "^2.9.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.38.0",
    "eslint-plugin-vue": "^10.5.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.1"
  }
}
